<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:bpmnr="http://bpmn-react.io/schema/1.0"
    id="Definitions_PR01"
    targetNamespace="https://buildtovalue.io/privacidade/lgpd"
    exporter="bpmn-react">
  <bpmn:collaboration id="Collaboration_PR01">
    <bpmn:participant id="Pool_PR01" name="Programa de privacidade e proteção de dados" processRef="Process_PR01"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_PR01" name="PR-01 · Emissão de parecer técnico de privacidade" isExecutable="false">
    <bpmn:extensionElements>
      <bpmnr:diagram originalId="PR01" description="Triagem, emissão, homologação e encerramento de pareceres técnicos de privacidade."/>
      <bpmnr:version versionId="ver-pr01-1-0-0" semanticVersion="1.0.0" status="draft"
        changeSummary="Modelagem inicial a partir da especificação de processos do programa." createdBy="engenharia-privacidade" createdAt="2026-07-28T00:00:00.000Z"/>
      <bpmnr:property name="dominio" value="&quot;privacidade&quot;"/>
      <bpmnr:property name="baseNormativa" value="&quot;LGPD Lei 13.709/2018&quot;"/>
      <bpmnr:property name="tabelasDMN" value="[&quot;D1&quot;, &quot;D2&quot;]"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_PR01">
      <bpmn:lane id="Lane_PR01_solicitante" name="Solicitante / squad">
        <bpmn:flowNodeRef>Start_PR01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR01_engpriv" name="Engenharia de privacidade">
        <bpmn:flowNodeRef>A1_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1_complexidade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_PR01_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PR01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR01_dpo" name="DPO / escritório de privacidade">
        <bpmn:flowNodeRef>A1_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2_risco</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR01_comite" name="Comitê de privacidade / diretoria">
        <bpmn:flowNodeRef>A1_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PR01_sla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_PR01" name="Demanda de privacidade recebida">
      <bpmn:messageEventDefinition id="Start_PR01_def"/>
    </bpmn:startEvent>
    <bpmn:userTask id="A1_1" name="A1.1 Registrar nova demanda">
      <bpmn:extensionElements>
        <bpmnr:property name="executor" value="&quot;Solicitante / squad&quot;"/>
        <bpmnr:property name="prazo" value="&quot;10 dias úteis antes do go-live&quot;"/>
        <bpmnr:property name="evidencia" value="&quot;Ticket de intake com anexos&quot;"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="A1_2" name="A1.2 Triagem e mapeamento do tratamento">
      <bpmn:extensionElements>
        <bpmnr:property name="executor" value="&quot;Engenharia de privacidade&quot;"/>
        <bpmnr:property name="prazo" value="&quot;2 dias úteis&quot;"/>
        <bpmnr:property name="evidencia" value="&quot;Ficha de triagem e DFD versionados&quot;"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1_complexidade" name="Complexidade? (DMN D1)">
      <bpmn:extensionElements>
        <bpmnr:property name="regra" value="&quot;D1&quot;"/>
        <bpmnr:property name="entradas" value="&quot;tipo de dado, volume, decisão automatizada, transferência internacional&quot;"/>
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A1_4" name="A1.4 Emitir o parecer técnico">
      <bpmn:extensionElements>
        <bpmnr:property name="executor" value="&quot;Engenharia de privacidade&quot;"/>
        <bpmnr:property name="prazo" value="&quot;5 a 8 dias úteis&quot;"/>
        <bpmnr:property name="evidencia" value="&quot;Parecer numerado e versionado&quot;"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="A1_5" name="A1.5 Escalar ao DPO">
      <bpmn:extensionElements>
        <bpmnr:property name="executor" value="&quot;DPO / escritório&quot;"/>
        <bpmnr:property name="prazo" value="&quot;3 dias úteis&quot;"/>
        <bpmnr:property name="evidencia" value="&quot;Ata da reunião de escalonamento&quot;"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Bnd_PR01_sla" name="Prazo de parecer excedido" attachedToRef="A1_4" cancelActivity="false">
      <bpmn:timerEventDefinition id="Bnd_PR01_sla_def">
        <bpmn:timeCycle>R/P8D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="A1_sla" name="A1.SLA Escalonar por estouro de prazo">
      <bpmn:extensionElements>
        <bpmnr:property name="executor" value="&quot;Comitê / diretoria&quot;"/>
        <bpmnr:property name="prazo" value="&quot;imediato&quot;"/>
        <bpmnr:property name="evidencia" value="&quot;Registro de escalonamento&quot;"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="End_PR01_sla" name="Escalonamento registrado"/>
    <bpmn:userTask id="A1_6" name="A1.6 Revisar e homologar o parecer">
      <bpmn:extensionElements>
        <bpmnr:property name="executor" value="&quot;DPO / escritório&quot;"/>
        <bpmnr:property name="prazo" value="&quot;3 dias úteis&quot;"/>
        <bpmnr:property name="evidencia" value="&quot;Registro de homologação&quot;"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2_risco" name="Risco residual? (DMN D2)">
      <bpmn:extensionElements>
        <bpmnr:property name="regra" value="&quot;D2&quot;"/>
        <bpmnr:property name="saidas" value="&quot;baixo, moderado, alto, crítico&quot;"/>
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A1_8" name="A1.8 Deliberar sobre o risco">
      <bpmn:extensionElements>
        <bpmnr:property name="executor" value="&quot;Comitê de privacidade&quot;"/>
        <bpmnr:property name="prazo" value="&quot;próxima reunião ordinária&quot;"/>
        <bpmnr:property name="evidencia" value="&quot;Ata e termo de aceite de risco&quot;"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="A1_9" name="A1.9 Implementar os controles recomendados">
      <bpmn:extensionElements>
        <bpmnr:property name="executor" value="&quot;Solicitante / squad&quot;"/>
        <bpmnr:property name="prazo" value="&quot;conforme condicionante&quot;"/>
        <bpmnr:property name="evidencia" value="&quot;Evidências técnicas de cada controle&quot;"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="A1_10" name="A1.10 Verificar evidências e encerrar">
      <bpmn:extensionElements>
        <bpmnr:property name="executor" value="&quot;Engenharia de privacidade&quot;"/>
        <bpmnr:property name="prazo" value="&quot;3 dias úteis&quot;"/>
        <bpmnr:property name="evidencia" value="&quot;Checklist de verificação e RoPA atualizado&quot;"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="End_PR01" name="Parecer encerrado com evidências"/>
    <bpmn:textAnnotation id="Note_PR01">
      <bpmn:text>Evidência que não comprova o controle reabre a implementação (A1.9).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="F01_01" sourceRef="Start_PR01" targetRef="A1_1"/>
    <bpmn:sequenceFlow id="F01_02" sourceRef="A1_1" targetRef="A1_2"/>
    <bpmn:sequenceFlow id="F01_03" sourceRef="A1_2" targetRef="G1_complexidade"/>
    <bpmn:sequenceFlow id="F01_04" name="baixa ou média" sourceRef="G1_complexidade" targetRef="A1_4"/>
    <bpmn:sequenceFlow id="F01_05" name="alta" sourceRef="G1_complexidade" targetRef="A1_5"/>
    <bpmn:sequenceFlow id="F01_06" sourceRef="A1_4" targetRef="A1_6"/>
    <bpmn:sequenceFlow id="F01_07" sourceRef="A1_5" targetRef="A1_6"/>
    <bpmn:sequenceFlow id="F01_08" sourceRef="A1_6" targetRef="G2_risco"/>
    <bpmn:sequenceFlow id="F01_09" name="alto ou crítico" sourceRef="G2_risco" targetRef="A1_8"/>
    <bpmn:sequenceFlow id="F01_10" name="baixo ou moderado" sourceRef="G2_risco" targetRef="A1_9"/>
    <bpmn:sequenceFlow id="F01_11" sourceRef="A1_8" targetRef="A1_9"/>
    <bpmn:sequenceFlow id="F01_12" sourceRef="A1_9" targetRef="A1_10"/>
    <bpmn:sequenceFlow id="F01_13" sourceRef="A1_10" targetRef="End_PR01"/>
    <bpmn:sequenceFlow id="F01_14" sourceRef="Bnd_PR01_sla" targetRef="A1_sla"/>
    <bpmn:sequenceFlow id="F01_15" sourceRef="A1_sla" targetRef="End_PR01_sla"/>
    <bpmn:association id="Assoc_Note_PR01" sourceRef="A1_10" targetRef="Note_PR01"/>
  </bpmn:process>
