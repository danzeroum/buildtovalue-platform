# .env do DEPLOY (fica em deploy/.env — o compose lê o .env do diretório dele).
# Recorte de VPS; o contrato de DEV continua sendo o `.env.example` da raiz.
#
#   cp deploy/.env.example deploy/.env    # e preencha os três segredos abaixo
#
# deploy/.env é ignorado pelo git e pelo build (.gitignore/.dockerignore).
# NUNCA comite este arquivo preenchido.

# --- OBRIGATÓRIOS (o compose falha alto se faltarem) ------------------------

# Senha do papel de MIGRAÇÃO (app_migrator, dono do banco).
#   openssl rand -hex 32
MIGRATOR_PASSWORD=

# Assinatura dos tokens. Mínimo 32 caracteres (validado por zod no boot).
#   openssl rand -base64 48
JWT_SECRET=

# Chave da cifra de campos `sensitive` (D20). Mínimo 16 caracteres.
# Chave ESTÁTICA: suficiente para teste/demo, REPROVA o gate de piloto por
# construção — o piloto exige envelope por KMS.
#   openssl rand -base64 32
FIELD_KEY_SECRET=

# Senha das personas do demo (`--profile seed`). Mínimo 12 caracteres.
# NÃO tem default: o `seed:demo` falha alto sem ela, de propósito. Enquanto
# tinha (`demo1234`, no código versionado), o ambiente alcançável pela internet
# autenticava com a senha que qualquer pessoa lia no repositório.
# Obrigatória SÓ para rodar o seed; a stack sobe sem ela.
#   openssl rand -base64 18
SEED_PASSWORD=

# --- OPCIONAIS (têm default) -----------------------------------------------

# Porta no host para diagnóstico (`curl http://127.0.0.1:$API_HOST_PORT/ready`).
# A internet NÃO passa por aqui — chega pelo ingress na rede compartilhada.
# Troque se 3000 já estiver ocupada na VPS.
API_HOST_PORT=3000

# Teto do rate limit da api (req/min por chave).
RATE_LIMIT_MAX=120

# Resolvedor de `secret://` do worker: env | file. Use `file` para o ensaio
# com chave de IA real (ver deploy-vps.md §8).
SECRET_BACKEND=env
SECRET_HOST_DIR=./secrets

# Taxa USD→BRL (configuração, NÃO cotação de rede). Sem ela, um modelo cotado
# em USD faz parada honesta com motivo `fx-missing`.
FX_USD_BRL=5.40
