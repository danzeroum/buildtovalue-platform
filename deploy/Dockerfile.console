# Console — SPA Vite servido por nginx. Multi-stage: o builder compila o
# monorepo, o runtime carrega SÓ os estáticos (nenhum Node em produção).
# Contexto de build = raiz do repo (o compose passa context: ..).
#
# `pnpm -r build` é obrigatório (e não `--filter @platform/console`): o build do
# console encadeia `sdk:generate`, que precisa do dist da api — e a api, do dist
# de db/config/auth/observability/api-contracts. A ordem topológica do -r resolve
# isso. O `openapi:emit` roda com fakeDeps + stubs que lançam se chamados: NÃO
# toca banco nem exige env (é o mesmo caminho do job `ci`).

FROM node:22-slim AS builder
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm -r build

FROM nginx:alpine AS runtime
COPY --from=builder /repo/apps/console/dist /usr/share/nginx/html
COPY deploy/console-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
